#!/usr/bin/env bash
# Build the firmware: ./build (the release image, into out/) or ./build --dev (a dev build, into out-dev/)
# ESP-IDF from $IDF_PATH (default /opt/esp-idf). Writes <out>/wiscosat.bin (the app), <out>/flash_args (what goes
# where at a first flash: esptool.py write_flash @flash_args, run in <out>/) and <out>/wiscosat.sha256.
# The output goes to out/ (idf.py -B out): a folder build/ cannot sit beside this script.
# A dev build (sdkconfig.dev on top of sdkconfig.defaults, its own sdkconfig in out-dev/) adds the command download
# and its version ends in -dev; out/ is always the release image. ./build --dev --broken: a dev build that cannot
# join any Wi-Fi (sdkconfig.broken), into out-broken/, version ending in -broken-dev: the rollback check's image. The version is git describe --tags --always
# --dirty, in the image's app description (32 bytes at offset 48 of the .bin) and in status.
# Exit 0 built, 1 the build failed, 2 no ESP-IDF or a wrong argument. Nothing of a unit is built in: its settings
# are in its NVS.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

idf_path="${IDF_PATH:-/opt/esp-idf}"
die() { echo "build: $1" >&2; exit "${2:-1}"; }

usage="usage: ./build [--dev [--broken]]"
case "${*:-}" in
'') out=out sdkconfig=sdkconfig defaults=(sdkconfig.defaults) suffix= ;;
--dev) out=out-dev sdkconfig=out-dev/sdkconfig defaults=(sdkconfig.defaults sdkconfig.dev) suffix=-dev ;;
'--dev --broken')
    out=out-broken sdkconfig=out-broken/sdkconfig suffix=-broken-dev
    defaults=(sdkconfig.defaults sdkconfig.dev sdkconfig.broken) ;;
*) die "$usage" 2 ;;
esac
[ -f "$idf_path/export.sh" ] || die "no ESP-IDF in $idf_path (set IDF_PATH)" 2

# export.sh puts idf.py and the compilers on the PATH; it is chatty, so only its errors are shown
# shellcheck disable=SC1091
. "$idf_path/export.sh" > /dev/null || die "ESP-IDF's export.sh failed" 2

# the defaults win: a sdkconfig older than any of them is made again (idf.py would keep its old values)
for d in "${defaults[@]}"; do
    [ "$sdkconfig" -nt "$d" ] || rm -f "$sdkconfig"
done

# the image's version, given each time so a new commit is never built with the last one's
version="$(git describe --tags --always --dirty)$suffix"
[ ${#version} -le 31 ] || die "the version $version is over 31 characters (the app description holds 32 bytes)"

mkdir -p "$out"
idf.py -B "$out" -DSDKCONFIG="$sdkconfig" -DSDKCONFIG_DEFAULTS="$(IFS=';'; echo "${defaults[*]}")" \
    -DPROJECT_VER="$version" build || die "idf.py build failed"
(cd "$out" && sha256sum wiscosat.bin > wiscosat.sha256)
size=$(stat -c %s "$out/wiscosat.bin")
echo "build: $out/wiscosat.bin, $size bytes, version $version; $(cat "$out/wiscosat.sha256")"
