#!/usr/bin/env bash
# Build and run the Linux tests of the firmware's pure parts (keys, armed, proto, seedrules, updrules, lockout, settings,
# usbserial, wlsplit, menu, powerrules): ./test
# Built and run twice: as the release image's parts, then as the dev build's (-DSAT_DEV, ./build --dev).
# Uses the host's cc and cJSON from ESP-IDF's tree ($IDF_PATH, default /opt/esp-idf); no ESP-IDF build, no board.
# Built with AddressSanitizer and UBSan, so a memory or arithmetic fault fails the run too.
# Exit 0 all passed, 1 a check failed or the tests did not build, 2 no cJSON.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

cjson="${IDF_PATH:-/opt/esp-idf}/components/json/cJSON"
die() { echo "test: $1" >&2; exit "${2:-1}"; }
[ -f "$cjson/cJSON.c" ] || die "no cJSON in $cjson (set IDF_PATH)" 2

out=out/test
mkdir -p "$out"
# shellcheck disable=SC2054 # the comma is part of one flag
san=(-fsanitize=address,undefined -fno-sanitize-recover=undefined)
# cJSON is not ours: built without our warnings
cc -std=c11 -O1 -g "${san[@]}" -c "$cjson/cJSON.c" -o "$out/cJSON.o" || die "cJSON did not build"
parts=(main/keys.c main/armed.c main/proto.c main/seedrules.c main/updrules.c main/lockout.c main/settings.c main/usbserial.c main/wlsplit.c main/menu.c main/powerrules.c)
for build in release dev; do
    defs=()
    [ "$build" = dev ] && defs=(-DSAT_DEV)
    cc -std=c11 -O1 -g -Wall -Wextra -Werror "${san[@]}" "${defs[@]}" -I main -I "$cjson" \
        tests/*.c "${parts[@]}" "$out/cJSON.o" -o "$out/tests-$build" ||
        die "the tests did not build ($build)"
    echo "test: $build"
    "$out/tests-$build" || die "a check failed ($build)"
done
