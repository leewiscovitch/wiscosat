CONFIG_IDF_TARGET="esp32s3"
# 8 MB: the smallest flash a unit may have; a bigger chip runs the same image
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_FREERTOS_HZ=1000
CONFIG_TINYUSB_HID_COUNT=1
# UART log output costs boot time (115200 baud, blocking); keep it quiet
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# seed drive: a 1 MB FAT partition shown to the host as a read-only USB drive
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_FATFS_USE_LABEL=y
CONFIG_FATFS_LFN_HEAP=y
# The channel: TLS 1.3 only, PSK with (EC)DHE only (no plain PSK, no certificates in use)
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_PSK=n
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_EPHEMERAL=n
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_PSK_EPHEMERAL=y
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
# A stuck firmware restarts itself: the task watchdog (idle tasks starved 5 s) panics, and a panic restarts
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
